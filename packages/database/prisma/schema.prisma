generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  BLOCKED
  CODE_COMPLETE
  TEST_FAILED
  READY_FOR_REVIEW
  VERIFIED
  CANCELLED
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum DecisionStatus {
  PROPOSED
  ACCEPTED
  SUPERSEDED
  REJECTED
}
enum SessionState {
  QUEUED
  STARTING
  RUNNING
  WAITING_FOR_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT
}
enum EvidenceKind {
  CHANGED_FILES
  GIT_DIFF
  GIT_STATUS
  TYPECHECK
  LINT
  UNIT_TEST
  INTEGRATION_TEST
  BUILD
  MIGRATION
  SCREENSHOT
  ARTIFACT
  COMMAND
}
enum Confidence {
  LOW
  MEDIUM
  HIGH
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum ProviderAuthenticationStatus {
  AUTHENTICATED
  NOT_AUTHENTICATED
  RATE_LIMITED
  NETWORK_ERROR
  CLI_ERROR
  UNKNOWN
}
enum QuotaSource {
  CLI_STATUS
  PROVIDER_RESPONSE
  LOCAL_ESTIMATE
  USER_INPUT
  OFFICIAL_API
}
enum ConversationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
enum ConversationRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}
enum ConversationMode {
  ASK
  IMPLEMENT
  REVIEW
  CONTINUE
  VERIFY
}
enum ConversationMessageStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}
enum ProviderSessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}
enum OutboxEventStatus {
  PENDING
  DISPATCHING
  PUBLISHED
  FAILED
  DEAD_LETTER
}
/// How an execution's model was determined, in priority order from most to least specific.
/// PROVIDER_DEFAULT means no override was applied anywhere in the chain - the CLI/account's
/// own default model applies, and no --model flag is passed.
enum ModelSource {
  USER_SELECTED
  PROJECT_DEFAULT
  SYSTEM_DEFAULT
  PROVIDER_DEFAULT
}
/// Result of a model-validation probe (see packages/providers probeModel). Distinct from
/// ProviderAuthenticationStatus because "is this specific model usable" is a narrower
/// question than "is this provider authenticated" - a provider can be AUTHENTICATED while
/// a particular model is UNSUPPORTED for the account, or vice versa mid-outage.
enum ModelAvailabilityStatus {
  AVAILABLE
  UNSUPPORTED
  NOT_AUTHENTICATED
  RATE_LIMITED
  NETWORK_ERROR
  UNKNOWN
}

model OutboxEvent {
  id          String @id @default(cuid())
  topic       String
  jobId       String @unique
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastErrorCode String?
  lastErrorMessage String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status,createdAt])
  @@index([status,nextAttemptAt])
}

model LocalSession {
  id         String @id @default(cuid())
  token      String @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt  DateTime?
}

model Project {
  id                String @id @default(cuid())
  name              String
  repositoryPath    String @unique
  defaultProvider   String @default("codex-cli")
  /// Project-level model defaults (see packages/shared MODEL_REGISTRY). Null means "no
  /// project override" - the application default (or provider CLI default) applies instead.
  /// Never trusted as a raw browser-supplied model id; validated against the server-side
  /// registry before being written here.
  defaultClaudeModel String?
  defaultCodexModel  String?
  defaultCodexReasoningEffort String?
  allowedCommands   Json
  permittedPaths    Json
  /** Set only by the verification harness; never inferred from browser input. */
  verificationRunId String?
  isVerification    Boolean @default(false)
  archivedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tasks             Task[]
  decisions         Decision[]
  memoryUpdates     MemoryUpdate[]
  checkpoints       Checkpoint[]
  sessions          AgentSession[]
  auditEvents       AuditEvent[]
  approvals         Approval[]
  conversations     Conversation[]
  @@index([isVerification, verificationRunId])
}

model Conversation {
  id                String @id @default(cuid())
  projectId         String
  project           Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  title             String
  status            ConversationStatus @default(ACTIVE)
  activeProviderId  String?
  currentCheckpointId String?
  sequence          Int @default(0)
  handoffSequence   Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  messages          ConversationMessage[]
  providerSessions  ProviderSession[]
  handoffCapsules   HandoffCapsule[]
  routingDecisions  RoutingDecision[]
  agentSessions     AgentSession[]
  @@index([projectId,updatedAt])
}
model ConversationMessage {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  role ConversationRole
  providerId String?
  providerSessionId String?
  providerSession ProviderSession? @relation("MessageProviderSession",fields:[providerSessionId],references:[id],onDelete:SetNull)
  /// Denormalized from the linked AgentSession at creation time (same pattern as
  /// providerId/mode below) so the timeline UI can show requested/resolved model on every
  /// assistant message without a join. See AgentSession.requestedModel/resolvedModel for
  /// the authoritative per-execution record.
  requestedModel String?
  resolvedModel String?
  mode ConversationMode
  content String
  status ConversationMessageStatus @default(QUEUED)
  idempotencyKey String?
  handoffCapsuleId String?
  handoffCapsule HandoffCapsule? @relation(fields:[handoffCapsuleId],references:[id],onDelete:SetNull)
  taskId String?
  task Task? @relation(fields:[taskId],references:[id],onDelete:Restrict)
  agentSessionId String? @unique
  agentSession AgentSession? @relation("AssistantMessage",fields:[agentSessionId],references:[id],onDelete:SetNull)
  triggeredSessions AgentSession[] @relation("TriggerMessage")
  lastMessageOfSession ProviderSession? @relation("ProviderSessionLastMessage")
  routingDecisions RoutingDecision[]
  createdAt DateTime @default(now())
  @@index([conversationId,createdAt])
  @@unique([conversationId,idempotencyKey])
}
model ProviderSession {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  providerId String
  externalSessionId String?
  /// The model this provider session is pinned to, set once at creation from the
  /// server-resolved effective model (null means Default) and never changed afterward.
  /// Continuing/resuming this session must request the same model; a different model
  /// requires a new ProviderSession instead of silently reusing this one under an
  /// incompatible model - see queueConversationMessage. Distinct from
  /// AgentSession.resolvedModel, which is per-execution and reflects what the CLI's own
  /// stream actually reported for that one turn.
  resolvedModel String?
  reasoningEffort String?
  status ProviderSessionStatus @default(QUEUED)
  startedAt DateTime?
  endedAt DateTime?
  lastMessageId String? @unique
  lastMessage ConversationMessage? @relation("ProviderSessionLastMessage",fields:[lastMessageId],references:[id],onDelete:SetNull)
  messages ConversationMessage[] @relation("MessageProviderSession")
  agentSessions AgentSession[]
  @@index([conversationId,providerId,startedAt])
}
model HandoffCapsule {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  fromProviderId String
  toProviderId String
  /// Set only when this handoff was triggered (in whole or in part) by a model change
  /// rather than a provider change - e.g. switching from Claude Sonnet to Claude Opus.
  fromModel String?
  toModel String?
  version Int
  objective String
  relevantDecisions Json
  filesChanged Json
  gitBaseline Json
  gitDiffSummary String
  tests Json
  unresolvedIssues Json
  acceptedFindings Json
  sourceMessageRange Json
  checksum String
  messages ConversationMessage[]
  createdAt DateTime @default(now())
  @@unique([conversationId,version])
}
model RoutingDecision {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  userMessageId String?
  userMessage ConversationMessage? @relation(fields:[userMessageId],references:[id],onDelete:Cascade)
  requestedProviderId String?
  selectedProviderId String
  requestedModel String?
  selectedModel String?
  reason String
  providerHealthSnapshot Json
  createdAt DateTime @default(now())
  @@index([conversationId,createdAt])
  @@index([userMessageId])
}

model ProviderHealth {
  providerId            String @id
  installed             Boolean @default(false)
  version               String?
  authentication        ProviderAuthenticationStatus @default(UNKNOWN)
  available             Boolean @default(false)
  latencyMs             Int?
  lastChecked           DateTime?
  lastAuthenticationCheck DateTime?
  lastSuccessfulRequest DateTime?
  lastRateLimitResponse DateTime?
  resetAt               DateTime?
  remainingPercent      Float?
  quotaSource           QuotaSource @default(CLI_STATUS)
  quotaConfidence       Confidence @default(LOW)
  quotaExact            Boolean @default(false)
  checkInProgress       Boolean @default(false)
  checkStartedAt        DateTime?
  updatedAt             DateTime @updatedAt
}

model ProviderHealthCheck {
  id             String @id @default(cuid())
  providerId     String
  mode           String
  authentication ProviderAuthenticationStatus
  installed      Boolean
  available      Boolean
  latencyMs      Int?
  createdAt      DateTime @default(now())
  @@index([providerId, createdAt])
}

/// Cached result of a safe, harmless model-validation probe (packages/providers
/// probeModel), bounded to a TTL by `checkedAt` rather than trusted forever - see
/// apps/worker/src/model-health.ts. `checkInProgress` mirrors ProviderHealth's
/// dedup-in-flight pattern so a burst of UI requests never spawns concurrent probes for
/// the same model.
model ModelHealth {
  providerId      String
  modelId         String
  reasoningEffort String?
  status          ModelAvailabilityStatus @default(UNKNOWN)
  /// Sanitized human-readable reason from the last probe - never a raw stack trace,
  /// credential path, token, or full spawn argument list.
  reason          String?
  checkedAt       DateTime?
  checkInProgress Boolean @default(false)
  checkStartedAt  DateTime?
  updatedAt       DateTime @updatedAt
  @@id([providerId, modelId])
}

/// Single-row application-wide defaults (see also Project.defaultClaudeModel /
/// defaultCodexModel / defaultCodexReasoningEffort for the project-level tier). Priority
/// chain: explicit execution selection -> project default -> application default ->
/// provider CLI default.
model ApplicationSettings {
  id                          String @id @default("singleton")
  defaultClaudeModel          String?
  defaultCodexModel           String?
  defaultCodexReasoningEffort String?
  updatedAt                   DateTime @updatedAt
}

model Task {
  id                 String @id @default(cuid())
  projectId          String
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  userRequest        String
  objective          String
  status             TaskStatus @default(PLANNED)
  priority           Priority @default(MEDIUM)
  relevantFiles      Json
  constraints        Json
  prohibitedChanges  Json
  assignedProvider   String @default("codex-cli")
  reviewRounds       Int @default(0)
  remediationAttempts Int @default(0)
  activeSessionId    String?
  parentTaskId       String?
  parentTask         Task? @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  childTasks         Task[] @relation("TaskHierarchy")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  criteria           AcceptanceCriterion[]
  capsules           TaskCapsule[]
  sessions           AgentSession[]
  evidence           Evidence[]
  memoryUpdates      MemoryUpdate[]
  reviewFindings     ReviewFinding[]
  conversationMessages ConversationMessage[]
}

model AcceptanceCriterion {
  id          String @id @default(cuid())
  taskId      String
  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  description String
  evidenceKinds Json
  commandIds Json
  passed      Boolean @default(false)
  evidence    Evidence[]
  createdAt   DateTime @default(now())
}

model Decision {
  id           String @id
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  context      String
  decision     String
  consequences String
  status       DecisionStatus @default(PROPOSED)
  locked       Boolean @default(false)
  forbiddenPaths Json
  requiredPatterns Json
  createdBy    String
  createdAt    DateTime @default(now())
  supersededBy String?
  @@unique([projectId, id])
}

model TaskCapsule {
  id                    String @id @default(cuid())
  taskId                String
  task                  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content               Json
  approximateTokenCount Int
  createdAt              DateTime @default(now())
}

model AgentSession {
  id          String @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  providerId  String
  state       SessionState @default(QUEUED)
  externalId  String?
  startedAt   DateTime?
  endedAt     DateTime?
  exitCode    Int?
  error       String?
  failureCode String?
  providerRootPid Int?
  providerProcessStartedAt DateTime?
  /// Exact operating-system start identity. This is intentionally separate from the
  /// displayable timestamp because Windows exposes sub-millisecond precision.
  providerProcessStartIdentity String?
  providerTerminationRequestedAt DateTime?
  providerTerminationCompletedAt DateTime?
  providerTerminationReason String?
  providerTerminationResult String?
  usage       Json?
  baselineCommit String?
  baselineDiffHash String?
  purpose     String @default("IMPLEMENTATION")
  readOnly    Boolean @default(false)
  /// The resolved ExecutionCapability ("READ_ONLY" | "WORKSPACE_WRITE") actually granted
  /// to this execution, persisted once at queue time so CONTINUE mode can later inherit
  /// it exactly rather than re-deriving it from the mode alone. Nullable only for rows
  /// created before this column existed.
  capability  String?
  /// Model actually requested for this execution (server-resolved through the priority
  /// chain: explicit selection -> project default -> application default -> provider CLI
  /// default). Null means Default was used - no --model flag was passed.
  requestedModel String?
  /// Model the provider CLI actually reported using, extracted from its own structured
  /// stream output where available (see packages/providers stream-parser.ts). May remain
  /// null if the CLI never reports one (see failureCode PROVIDER_MODEL_METADATA_MISSING).
  resolvedModel String?
  reasoningEffort String?
  modelSource ModelSource?
  /// The provider CLI version active when this execution ran, captured at queue time -
  /// a per-execution snapshot so historical executions keep showing the version that
  /// actually ran them even after the CLI is later upgraded (ProviderHealth.version is
  /// live/mutable and does not preserve this history on its own).
  providerVersion String?
  resolvedAt DateTime?
  providerSessionId String?
  providerSession ProviderSession? @relation(fields:[providerSessionId],references:[id],onDelete:SetNull)
  conversationId String?
  conversation Conversation? @relation(fields:[conversationId],references:[id],onDelete:SetNull)
  userMessageId String?
  userMessage ConversationMessage? @relation("TriggerMessage",fields:[userMessageId],references:[id],onDelete:SetNull)
  assistantMessage ConversationMessage? @relation("AssistantMessage")
  /** Owning worker's process id while STARTING/RUNNING; cleared once terminal. */
  workerId    String?
  /** Renewed by the owning worker's heartbeat; a recovery sweep only reclaims sessions whose lease has actually expired (or was never leased at all). */
  leaseExpiresAt DateTime?
  createdAt   DateTime @default(now())
  events      AgentEvent[]
  evidence    Evidence[]
  @@index([conversationId])
  @@index([userMessageId])
  @@index([state, leaseExpiresAt])
}

model ReviewFinding {
  id          String @id @default(cuid())
  taskId      String
  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sessionId   String?
  severity    String
  title       String
  body        String
  status      String @default("PENDING")
  stale       Boolean @default(false)
  createdAt   DateTime @default(now())
}

model AgentEvent {
  id        BigInt @id @default(autoincrement())
  sessionId String
  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  stream    String?
  message   String
  createdAt DateTime @default(now())
  @@index([sessionId, id])
}

model Evidence {
  id          String @id @default(cuid())
  taskId      String
  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  criterionId String?
  criterion   AcceptanceCriterion? @relation(fields: [criterionId], references: [id], onDelete: SetNull)
  kind        EvidenceKind
  commandId   String?
  startedAt   DateTime?
  endedAt     DateTime?
  exitCode    Int?
  output      String?
  artifactPath String?
  metadata    Json?
  successful  Boolean
  createdAt   DateTime @default(now())
}

model Checkpoint {
  id          String @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reason      String
  content     Json
  filePath    String
  gitCommit   String?
  gitBranch   String?
  dirty       Boolean
  createdAt   DateTime @default(now())
}

model MemoryUpdate {
  id          String @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  file        String
  changed     String
  reason      String
  agent       String
  evidenceRef String?
  confidence  Confidence
  createdAt   DateTime @default(now())
}

model Approval {
  id          String @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action      String
  rationale   String
  status      ApprovalStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
}

model AuditEvent {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  details   Json
  createdAt DateTime @default(now())
}

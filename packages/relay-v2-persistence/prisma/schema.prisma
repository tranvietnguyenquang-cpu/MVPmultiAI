generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("RELAY_V2_DATABASE_URL")
}

model Project {
  id              String   @id
  name            String
  slug            String   @unique
  localPath       String
  pathKey         String   @unique
  description     String   @default("")
  defaultExecutor String   @default("AUTO")
  defaultReviewer String   @default("AUTO")
  defaultModel    String   @default("AUTO")
  defaultEffort   String   @default("AUTO")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tasks           Task[]
  auditEvents     AuditEvent[]
  importReports   ImportReport[]
  executionSessions ExecutionSession[]
}

model Task {
  id                String   @id
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId        String?
  idempotencyKey    String
  title             String
  objective         String
  source            String
  taskType          String
  complexity        String
  status            String   @default("DRAFT")
  context           String   @default("")
  suggestedExecutor String   @default("AUTO")
  suggestedModel    String   @default("AUTO")
  suggestedEffort   String   @default("AUTO")
  selectedExecutor  String   @default("AUTO")
  selectedModel     String   @default("AUTO")
  selectedEffort    String   @default("AUTO")
  reviewer           String   @default("AUTO")
  requireApproval    Boolean  @default(true)
  specVersion        Int      @default(1)
  specHash           String
  normalizedSpecJson String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  approvedAt         DateTime?
  cancelledAt        DateTime?
  constraints        TaskConstraint[]
  acceptanceCriteria AcceptanceCriterion[]
  permissions        TaskPermission[]
  approvals          Approval[]
  auditEvents         AuditEvent[]
  executionSessions   ExecutionSession[]

  @@unique([projectId, source, idempotencyKey])
  @@unique([projectId, source, externalId])
  @@index([projectId, status, createdAt])
}

model TaskConstraint {
  id      String @id
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ordinal Int
  text    String

  @@unique([taskId, ordinal])
}

model AcceptanceCriterion {
  id          String @id
  taskId      String
  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ordinal     Int
  description String

  @@unique([taskId, ordinal])
}

model TaskPermission {
  id         String @id
  taskId     String
  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ordinal    Int
  permission String
  valueJson  String

  @@unique([taskId, permission])
  @@unique([taskId, ordinal])
}

model Approval {
  id              String   @id
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approvalType    String
  requestedBy     String
  resolvedBy      String?
  status          String   @default("PENDING")
  specHash        String
  approvedSpecJson String
  executor        String
  model           String
  effort          String
  reviewer        String
  permissionsJson String
  requestedAt     DateTime @default(now())
  resolvedAt      DateTime?
  invalidatedAt   DateTime?

  @@index([taskId, status, requestedAt])
}

model AuditEvent {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  executionSessionId String?
  executionSession ExecutionSession? @relation(fields: [executionSessionId], references: [id], onDelete: SetNull)
  actor       String
  action      String
  riskLevel   String
  detailsJson String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([executionSessionId, createdAt])
}

model ImportReport {
  id                  String   @id
  projectId           String?
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reportType          String
  status              String
  sourceCountsJson    String
  candidateCountsJson String
  skippedCountsJson   String
  reasonsJson         String
  createdAt           DateTime @default(now())

  @@index([projectId, createdAt])
}

model ExecutionSession {
  id                      String   @id
  taskId                  String
  task                    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId               String
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executorId              String
  executorConfigJson      String   @default("{}")
  status                  String   @default("QUEUED")
  attempt                 Int      @default(0)
  workspacePath           String
  workspaceKey            String
  approvedSpecHash        String
  approvedExecutor        String
  approvedModel           String
  approvedEffort          String
  approvedReviewer        String
  approvedPermissionsHash String
  approvedTimeoutSeconds  Int      @default(1800)
  approvedVerificationJson String  @default("[]")
  dirtyBaselineAcknowledgedHash String?
  capsuleHash             String?
  capsuleJson             String   @default("{}")
  baselineEvidenceJson    String   @default("{}")
  finalEvidenceJson       String   @default("{}")
  processId               Int?
  processStartedAt        DateTime?
  processIdentity         String?
  processExitCode         Int?
  processSignal           String?
  verificationResultsJson String   @default("[]")
  queuedAt                DateTime @default(now())
  claimedAt               DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?
  cancelledAt             DateTime?
  timeoutAt               DateTime?
  heartbeatAt             DateTime?
  durationMs              Int?
  summary                 String   @default("")
  failureCode             String?
  failureMessage          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  events                  ExecutionEvent[]
  artifacts               ExecutionArtifact[]
  leases                  WorkspaceLease[]
  auditEvents             AuditEvent[]

  @@index([status, queuedAt])
  @@index([taskId, createdAt])
  @@index([workspaceKey, status])
}

model ExecutorCapabilitySnapshot {
  id                 String   @id
  executorId         String
  executablePath     String
  displayPath        String
  version            String
  authenticationStatus String
  supported          Boolean
  snapshotJson       String
  rawHelpHash        String
  detectedAt         DateTime
  createdAt          DateTime @default(now())

  @@index([executorId, detectedAt])
}

model ExecutionEvent {
  id          String   @id
  sessionId   String
  session     ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence    Int
  eventType   String
  level       String
  message     String
  payloadJson String
  createdAt   DateTime @default(now())

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

model ExecutionArtifact {
  id           String   @id
  sessionId    String
  session      ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  artifactType String
  relativePath String
  sha256       String
  byteCount    Int
  truncated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([sessionId, artifactType, relativePath])
  @@index([sessionId, createdAt])
}

model WorkspaceLease {
  id          String   @id
  workspaceKey String
  sessionId   String
  session     ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leaseToken  String
  acquiredAt DateTime @default(now())
  heartbeatAt DateTime
  expiresAt   DateTime
  releasedAt DateTime?

  @@index([workspaceKey, releasedAt])
  @@index([sessionId, releasedAt])
  @@index([expiresAt, releasedAt])
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("RELAY_V2_DATABASE_URL")
}

model Project {
  id              String   @id
  name            String
  slug            String   @unique
  localPath       String
  pathKey         String   @unique
  description     String   @default("")
  defaultExecutor String   @default("AUTO")
  defaultReviewer String   @default("AUTO")
  defaultModel    String   @default("AUTO")
  defaultEffort   String   @default("AUTO")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tasks           Task[]
  auditEvents     AuditEvent[]
  importReports   ImportReport[]
  executionSessions ExecutionSession[]
  reviewRequests    ReviewRequest[]
}

model Task {
  id                String   @id
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId        String?
  idempotencyKey    String
  title             String
  objective         String
  source            String
  taskType          String
  complexity        String
  status            String   @default("DRAFT")
  context           String   @default("")
  suggestedExecutor String   @default("AUTO")
  suggestedModel    String   @default("AUTO")
  suggestedEffort   String   @default("AUTO")
  selectedExecutor  String   @default("AUTO")
  selectedModel     String   @default("AUTO")
  selectedEffort    String   @default("AUTO")
  reviewer           String   @default("AUTO")
  requireApproval    Boolean  @default(true)
  specVersion        Int      @default(1)
  specHash           String
  normalizedSpecJson String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  approvedAt         DateTime?
  cancelledAt        DateTime?
  constraints        TaskConstraint[]
  acceptanceCriteria AcceptanceCriterion[]
  permissions        TaskPermission[]
  approvals          Approval[]
  auditEvents         AuditEvent[]
  executionSessions   ExecutionSession[]
  reviewRequests      ReviewRequest[]

  @@unique([projectId, source, idempotencyKey])
  @@unique([projectId, source, externalId])
  @@index([projectId, status, createdAt])
}

model TaskConstraint {
  id      String @id
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ordinal Int
  text    String

  @@unique([taskId, ordinal])
}

model AcceptanceCriterion {
  id          String @id
  taskId      String
  task        Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ordinal     Int
  description String

  @@unique([taskId, ordinal])
}

model TaskPermission {
  id         String @id
  taskId     String
  task       Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ordinal    Int
  permission String
  valueJson  String

  @@unique([taskId, permission])
  @@unique([taskId, ordinal])
}

model Approval {
  id              String   @id
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approvalType    String
  requestedBy     String
  resolvedBy      String?
  status          String   @default("PENDING")
  specHash        String
  approvedSpecJson String
  executor        String
  model           String
  effort          String
  reviewer        String
  permissionsJson String
  requestedAt     DateTime @default(now())
  resolvedAt      DateTime?
  invalidatedAt   DateTime?

  @@index([taskId, status, requestedAt])
}

model AuditEvent {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  executionSessionId String?
  executionSession ExecutionSession? @relation(fields: [executionSessionId], references: [id], onDelete: SetNull)
  actor       String
  action      String
  riskLevel   String
  detailsJson String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([executionSessionId, createdAt])
}

model ImportReport {
  id                  String   @id
  projectId           String?
  project             Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reportType          String
  status              String
  sourceCountsJson    String
  candidateCountsJson String
  skippedCountsJson   String
  reasonsJson         String
  createdAt           DateTime @default(now())

  @@index([projectId, createdAt])
}

model ExecutionSession {
  id                      String   @id
  taskId                  String
  task                    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId               String
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executorId              String
  executorConfigJson      String   @default("{}")
  status                  String   @default("QUEUED")
  attempt                 Int      @default(0)
  workspacePath           String
  workspaceKey            String
  approvedSpecHash        String
  approvedExecutor        String
  approvedModel           String
  approvedEffort          String
  approvedReviewer        String
  approvedPermissionsHash String
  approvedTimeoutSeconds  Int      @default(1800)
  approvedVerificationJson String  @default("[]")
  dirtyBaselineAcknowledgedHash String?
  capsuleHash             String?
  capsuleJson             String   @default("{}")
  baselineEvidenceJson    String   @default("{}")
  finalEvidenceJson       String   @default("{}")
  processId               Int?
  processStartedAt        DateTime?
  processIdentity         String?
  processExitCode         Int?
  processSignal           String?
  verificationResultsJson String   @default("[]")
  queuedAt                DateTime @default(now())
  claimedAt               DateTime?
  startedAt               DateTime?
  finishedAt              DateTime?
  cancelledAt             DateTime?
  timeoutAt               DateTime?
  heartbeatAt             DateTime?
  durationMs              Int?
  summary                 String   @default("")
  failureCode             String?
  failureMessage          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  events                  ExecutionEvent[]
  artifacts               ExecutionArtifact[]
  leases                  WorkspaceLease[]
  auditEvents             AuditEvent[]
  reviewRequests          ReviewRequest[]

  @@index([status, queuedAt])
  @@index([taskId, createdAt])
  @@index([workspaceKey, status])
}

model ExecutorCapabilitySnapshot {
  id                 String   @id
  executorId         String
  executablePath     String
  displayPath        String
  version            String
  authenticationStatus String
  supported          Boolean
  snapshotJson       String
  rawHelpHash        String
  detectedAt         DateTime
  createdAt          DateTime @default(now())

  @@index([executorId, detectedAt])
}

model ExecutionEvent {
  id          String   @id
  sessionId   String
  session     ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence    Int
  eventType   String
  level       String
  message     String
  payloadJson String
  createdAt   DateTime @default(now())

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
}

model ExecutionArtifact {
  id           String   @id
  sessionId    String
  session      ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  artifactType String
  relativePath String
  sha256       String
  byteCount    Int
  truncated    Boolean  @default(false)
  schemaVersion     String   @default("")
  fullContentSha256 String   @default("")
  originalByteCount Int      @default(0)
  omittedByteCount  Int      @default(0)
  truncationMethod  String   @default("NONE")
  /** The producer's own versioned provenance object, carried through to the reviewer unchanged (LOG record counts, capture completeness). '{}' for artifact types that add nothing beyond the columns above. */
  provenanceJson    String   @default("{}")
  createdAt    DateTime @default(now())

  @@unique([sessionId, artifactType, relativePath])
  @@index([sessionId, createdAt])
}

model WorkspaceLease {
  id          String   @id
  workspaceKey String
  sessionId   String
  session     ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leaseToken  String
  acquiredAt DateTime @default(now())
  heartbeatAt DateTime
  expiresAt   DateTime
  releasedAt DateTime?

  @@index([workspaceKey, releasedAt])
  @@index([sessionId, releasedAt])
  @@index([expiresAt, releasedAt])
}

model ReviewRequest {
  id                       String   @id
  executionSessionId       String
  executionSession          ExecutionSession @relation(fields: [executionSessionId], references: [id], onDelete: Cascade)
  projectId                String
  project                  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId                   String
  task                     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewerId               String
  reviewAuthority          String
  diagnosticRequested      Boolean  @default(false)
  approvalId               String
  approvalStatus           String
  approvalReviewerSelection String
  taskSelectedReviewer     String
  executionExecutorId      String
  status                   String   @default("PENDING")
  attempt                  Int      @default(0)
  taskSpecHash             String
  approvalSnapshotHash     String
  executionCapsuleHash     String
  baselineGitEvidenceHash  String
  finalGitEvidenceHash     String
  verificationResultsHash  String
  executionArtifactSetHash String
  executionResultStatus    String
  finalBranch              String
  finalHead                String
  reviewPolicyVersion      String
  reviewInputJson          String
  reviewInputHash          String
  requestHash              String
  reviewerConfigJson       String   @default("{}")
  reviewerConfigHash       String
  materialBudgetPolicyVersion String @default("")
  materialBudgetLedgerJson    String @default("{}")
  materialBudgetLedgerHash    String @default("")
  requestedBy              String
  requestedAt              DateTime @default(now())
  ownerId                  String?
  leaseToken               String?
  claimedAt                DateTime?
  heartbeatAt              DateTime?
  leaseExpiresAt           DateTime?
  cancellationRequestedAt  DateTime?
  claimAttempts            Int      @default(0)
  startedAt                DateTime?
  finishedAt               DateTime?
  invalidatedAt            DateTime?
  failureCode              String?
  failureMessage           String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  verdicts                 ReviewVerdict[]
  events                   ReviewEvent[]
  invocations              ReviewInvocation[]

  @@index([executionSessionId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([status, requestedAt])
  @@index([status, leaseExpiresAt])
}

model ReviewVerdict {
  id                  String   @id
  reviewRequestId     String   @unique
  reviewRequest       ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  verdict             String
  summary             String
  findingsJson        String
  requiredActionsJson String
  confidence          Float
  reviewerVersion     String
  reviewedRequestHash String
  createdAt           DateTime @default(now())
}

model ReviewEvent {
  id              String   @id
  reviewRequestId String
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  sequence        Int
  eventType       String
  level           String
  message         String
  payloadJson     String
  createdAt       DateTime @default(now())

  @@unique([reviewRequestId, sequence])
  @@index([reviewRequestId, createdAt])
}

/** Reviewer-agnostic capability diagnostic history (mirrors ExecutorCapabilitySnapshot). Append-only: each refresh inserts a new row rather than updating. */
model ReviewerCapabilitySnapshot {
  id                   String   @id
  reviewerId           String
  displayPath          String
  version              String
  authenticationStatus String
  supported            Boolean
  snapshotJson         String
  helpHash             String
  detectedAt           DateTime
  createdAt            DateTime @default(now())
  invocations          ReviewInvocation[]

  @@index([reviewerId, detectedAt])
}

/**
 * Exactly zero or one row per ReviewRequest (`reviewRequestId` is UNIQUE):
 * the one durable, ownership-guarded lifecycle record of that request's
 * single reviewer invocation attempt (PREPARING at claim time through a
 * terminal status), enriched in place with process/hash detail by the
 * reviewer through ReviewControls.recordInvocation. Created atomically
 * (ReviewEngine.createOwnedInvocationOrThrow) only after the owning
 * ReviewRequest is proven RUNNING under the exact claiming ownership
 * generation, and only ever updated by that same ownership generation via a
 * CAS predicate -- a stale or superseded owner can never create or complete
 * one. Never a second row for the same request: a ReviewRequest can be
 * claimed at most once ever (claimNext requires PENDING and there is no path
 * back to PENDING), so "one invocation per request" and "no automatic
 * retry" are the same invariant. See migration.sql for the full rationale
 * and the immutability/ownership triggers.
 */
model ReviewInvocation {
  id                      String   @id
  reviewRequestId         String   @unique
  reviewRequest           ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  reviewerId              String
  status                  String   @default("PREPARING")
  ownerId                 String
  claimAttempt            Int      @default(0)
  capabilitySnapshotId    String?
  capabilitySnapshot      ReviewerCapabilitySnapshot? @relation(fields: [capabilitySnapshotId], references: [id], onDelete: SetNull)
  cliVersion              String   @default("")
  executableIdentityHash  String   @default("")
  materializerVersion     String   @default("")
  promptPolicyVersion     String   @default("")
  wrapperContractId       String   @default("")
  wrapperParserVersion    String   @default("")
  // Every identity below is computed and persisted BEFORE the reviewer process
  // is created, never after it exits: the row states what will be sent, and
  // finalization independently rebuilds all of it and requires an exact match.
  materialEnvelopeVersion String   @default("")
  materialBudgetPolicyVersion String @default("")
  materialBudgetLedgerJson String  @default("{}")
  reviewMaterialHash      String   @default("")
  exactMaterialEnvelopeByteCount Int @default(0)
  promptHash              String   @default("")
  finalPromptByteCount    Int      @default(0)
  materialBudgetLedgerHash String  @default("")
  finalStdinHash          String   @default("")
  finalStdinByteCount     Int      @default(0)
  promptAccountingJson    String   @default("{}")
  stdoutRedacted          String   @default("")
  stdoutTruncated         Boolean  @default(false)
  stderrRedacted          String   @default("")
  stderrTruncated         Boolean  @default(false)
  structuredOutputJson    String?
  processId               Int?
  processIdentity         String?
  processStartedAt        DateTime?
  processFinishedAt      DateTime?
  processExitCode         Int?
  processSignal           String?
  timedOut                Boolean  @default(false)
  cancelled               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([reviewerId, createdAt])
}
